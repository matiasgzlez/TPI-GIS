# PostgreSQL + PostGIS
POSTGRES_DB=tpi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# GeoServer
# Credenciales del admin de GeoServer (valores por defecto de la imagen; las usan los scripts)
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=geoserver
GEOSERVER_PORT=8080
# Usuario con permiso de escritura solo sobre obras_rn11 (lo usa el visor web)
GEOSERVER_EDITOR_USER=editor
GEOSERVER_EDITOR_PASSWORD=editor
